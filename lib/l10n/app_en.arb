{
  "@@locale": "en",
  "thinking": "Roäc is thinking…",
  "@thinking": {
    "description": "Shown in the bubble while the CLI is being waited on."
  },
  "invitation": "Ask me what you have written down.",
  "@invitation": {
    "description": "Shown in the bubble before anything has been asked."
  },
  "askHint": "Ask Roäc…",
  "@askHint": {
    "description": "The placeholder in the field a question is typed into."
  },
  "linkCopied": "That link would not open. Its address is on your clipboard.",
  "@linkCopied": {
    "description": "Said when a link in an answer cannot be opened, so its address was put on the clipboard instead."
  },
  "noQuestion": "Ask me something.",
  "@noQuestion": {
    "description": "Said when the question put to Roäc was empty."
  },
  "silence": "Roäc fell silent, and was let go.",
  "@silence": {
    "description": "Said when the CLI stopped speaking for so long it was killed."
  },
  "noCounsel": "Roäc found no counsel (the CLI exited {ending}).",
  "@noCounsel": {
    "description": "Said when the CLI ended without a last word and complained of nothing, leaving only its exit code.",
    "placeholders": {
      "ending": {
        "type": "int"
      }
    }
  },
  "surrender": "The CLI gave up.",
  "@surrender": {
    "description": "Said when the CLI reported a failure but named nothing that went wrong."
  },
  "packUnopenable": "{what} could not be read ({trouble}).",
  "@packUnopenable": {
    "description": "A flaw in a character pack: Unopenable.",
    "placeholders": {
      "what": {
        "type": "String"
      },
      "trouble": {
        "type": "String"
      }
    }
  },
  "packNotAZip": "That pack could not be opened ({trouble}).",
  "@packNotAZip": {
    "description": "A flaw in a character pack: NotAZip.",
    "placeholders": {
      "trouble": {
        "type": "String"
      }
    }
  },
  "packNoManifest": "That pack has no roac-pack.json in it.",
  "@packNoManifest": {
    "description": "A flaw in a character pack: NoManifest."
  },
  "packUnreadableManifest": "That pack's roac-pack.json is not readable ({trouble}).",
  "@packUnreadableManifest": {
    "description": "A flaw in a character pack: UnreadableManifest.",
    "placeholders": {
      "trouble": {
        "type": "String"
      }
    }
  },
  "packNotAManifest": "That pack's roac-pack.json is not a manifest.",
  "@packNotAManifest": {
    "description": "A flaw in a character pack: NotAManifest."
  },
  "packWrongFormat": "That pack is written in format {found}; this Roäc reads {readable}.",
