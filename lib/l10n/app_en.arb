    "description": "A flaw in a character pack: WrongFormat.",
    "placeholders": {
      "found": {
        "type": "String"
      },
      "readable": {
        "type": "int"
      }
    }
  },
  "packNoFrameSize": "That pack does not say how large a frame is.",
  "@packNoFrameSize": {
    "description": "A flaw in a character pack: NoFrameSize."
